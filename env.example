# Copiar este archivo como ".env" y completar con los valores reales.

# --- Credenciales de AWS (Access Key temporal de AWS Academy Learner Lab) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# --- Bucket S3 real donde se suben los archivos de ingesta ---
S3_BUCKET_REAL=hardtechhub-bucket

# --- Host de la VM de bases de datos (PostgreSQL y MySQL) ---
# IP publica o privada de la instancia EC2 donde corren postgres y mysql.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=hardtech_catalog
POSTGRES_USER=hardtech
POSTGRES_PASSWORD=hardtech

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=hardtech_orders
MYSQL_USER=hardtech
MYSQL_PASSWORD=hardtech

# --- DynamoDB (identity-service) ---
# Dejar DYNAMODB_ENDPOINT vacio para usar el DynamoDB REAL de AWS.
# Solo llenar con http://localstack:4566 si se prueba localmente con LocalStack.
DYNAMODB_ENDPOINT=
DYNAMODB_REGION=us-east-1
USERS_TABLE=users
